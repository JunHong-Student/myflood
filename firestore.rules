rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reko_historical_stats/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /kaggle_monthly_stats/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
